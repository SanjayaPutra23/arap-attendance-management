# Laravel standard ignore
/vendor
/node_modules
/public/storage
/storage/*.key
.env
.env.*
.phpunit.result.cache

# Laravel log & cache
/storage/logs/*
/storage/logs/laravel.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
!/storage/.gitignore
!/storage/logs/.gitignore
!/storage/framework/.gitignore

# Cache files
*.log
*.cache

# IDE/editor
.idea/
.vscode/

# OS-specific
.DS_Store
Thumbs.db

# Assets
/public/hot
/public/assets/img/*
!/public/assets/img/.gitkeep

# Docker
docker-compose.override.yml

# Homestead
Homestead.json
Homestead.yaml
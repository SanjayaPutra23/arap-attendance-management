# ==============================================================================
# ARAP v2 — Production Environment Configuration Template
# Sentra Pelayanan Pemenuhan Gizi (SPPG) Kalisapu
# ==============================================================================
# PENTING KEAMANAN:
# 1. Salin berkas ini ke '.env' pada server produksi: cp .env.production.example .env
# 2. Generate Application Key baru: php artisan key:generate
# 3. JANGAN PERNAH menyertakan kredensial / password produksi ke repositori Git!
# ==============================================================================

APP_NAME="ARAP SPPG Kalisapu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presensi.sppgkalisapu.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# HTTPS & REVERSE PROXY SETTINGS (WAJIB UNTUK PWA, KAMERA, & GPS GEOFENCE)
# ------------------------------------------------------------------------------
# Wajib diatur true agar semua URL asset dan redirect mengarah ke HTTPS.
FORCE_HTTPS=true

# Alamat IP reverse proxy (misal Nginx lokal di 127.0.0.1 atau Cloudflare).
# Kosongkan atau atur ke IP proxy Anda jika menggunakan Nginx/Traefik.
TRUSTED_PROXIES=127.0.0.1

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# DATABASE PRODUCTION (MYSQL 8.x)
# PERINGATAN KERAS:
# - Pastikan melakukan BACKUP LENGKAP database lama sebelum menjalankan migrasi!
# - Gunakan 'php artisan migrate --force'. JANGAN PERNAH memakai 'migrate:fresh'!
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arap
DB_USERNAME=arap_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MYSQL

# ------------------------------------------------------------------------------
# SESSION & COOKIE SECURITY
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# CACHE & QUEUE
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
# CACHE_PREFIX=arap_v2_cache_

# ------------------------------------------------------------------------------
# BCRYPT HASHER
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
# Submit presensi dibatasi 20 request/menit untuk mencegah bot spamming.
